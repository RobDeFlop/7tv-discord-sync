# Follow README.md to create an owner-only .env before adding credentials. Bun loads .env automatically.

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Minimum console level: debug, info, warn, error
LOG_LEVEL=info

# Postgres connection string. The bot runs its migrations on startup.
DATABASE_URL=postgres://user:password@localhost:5432/7tv_sync
